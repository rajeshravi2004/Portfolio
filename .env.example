# Server-only settings. Never prefix these with NEXT_PUBLIC_.
# Choose a unique password with at least 16 characters.
CHAT_ADMIN_PASSWORD=

# Google Doc or Drive .txt file (Anyone with the link: Viewer for public reading).
CHAT_DRIVE_FILE_URL=

# Required for saving from /rajesh-chat-update.
# Enable Google Drive API and Google Docs API. Share the source with this email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Chatbot provider. Set a text-generation model available to your Gemini account.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
